# ThunderClap preset
format = 1
name = Rolling Thunder
author = ThunderClap
description = A crooked, branching channel a few kilometres away: several claps, one after another, rolling for twenty seconds.
features = ambient, sfx, evolving

# Strike
distance = 2.5
height = 6
cloud_spread = 8
tortuosity = 0.7
branching = 0.7
strokes = 4
stroke_gap = 60
variation = 0.5

# Sound
crack = 0.5
weight = 0.55
swell = 0.3
rumble = 0.6
rumble_tone = 0.5
air = 0.5
scatter = 0.5
focus = 0.75
impact = 0.45

# Stereo
width = 0.85
pan = 0
rumble_width = 0.9
drift = 0.3

# Echoes
echo_level = -10
echo_count = 5
echo_spread = 2.5
echo_damping = 0.6

# Space
space_amount = 0.12
space_size = 0.5
space_damping = 0.5

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_key_track = 0

# Envelope
mode = One Shot
attack = 1
release = 1200
storm_rate = 6
vel_to_level = 0.5
vel_to_distance = 0.5

# Output
gain = -7.6
max_shocks = 2048
seed = 0

# Dynamics
compress = 0.35
comp_attack = 5
comp_release = 400

# ThunderClap preset
format = 1
name = Under The Rain
author = ThunderClap
description = Made to sit under RainyDay's Storm Front: a storm seven kilometres off, softened, never stepping on the rain.
features = ambient, soft, storm

# Strike
distance = 7
height = 6
cloud_spread = 8
tortuosity = 0.5
branching = 0.4
strokes = 3
stroke_gap = 70
variation = 0.7

# Sound
crack = 0.3
weight = 0.6
swell = 0.5
rumble = 0.6
rumble_tone = 0.4
air = 0.55
scatter = 0.5
focus = 0.7
impact = 0.2
bloom = 0

# Stereo
width = 0.85
pan = 0
rumble_width = 0.9
drift = 0.3

# Echoes
echo_level = -14
echo_count = 3
echo_spread = 3
echo_damping = 0.7

# Space
space_amount = 0.12
space_size = 0.5
space_damping = 0.5
ground = 0.5

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_key_track = 0

# Envelope
mode = Storm
attack = 1
release = 3000
storm_rate = 5
vel_to_level = 0.5
vel_to_distance = 0.5

# Output
gain = 10.8
max_shocks = 2048
seed = 0

# Dynamics
compress = 0
comp_attack = 3.16
comp_release = 250

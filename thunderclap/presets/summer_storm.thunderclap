# ThunderClap preset
format = 1
name = Summer Storm
author = ThunderClap
description = Hold a note and a storm passes: flashes every ten seconds or so, near and far, none of them alike.
features = ambient, evolving, storm

# Strike
distance = 4
height = 6
cloud_spread = 6
tortuosity = 0.55
branching = 0.5
strokes = 3
stroke_gap = 60
variation = 0.8

# Sound
crack = 0.5
weight = 0.55
swell = 0.35
rumble = 0.55
rumble_tone = 0.5
air = 0.5
scatter = 0.5
focus = 0.7
impact = 0.3
bloom = 0.25

# Stereo
width = 0.85
pan = 0
rumble_width = 0.9
drift = 0.3

# Echoes
echo_level = -12
echo_count = 4
echo_spread = 2.5
echo_damping = 0.6

# Space
space_amount = 0.12
space_size = 0.5
space_damping = 0.5
ground = 0.55

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_key_track = 0

# Envelope
mode = Storm
attack = 1
release = 3000
storm_rate = 7
vel_to_level = 0.5
vel_to_distance = 0.3

# Output
gain = 0
max_shocks = 2048
seed = 0

# Dynamics
compress = 0.25
comp_attack = 5
comp_release = 400

# ThunderClap preset
format = 1
name = City Thunder
author = ThunderClap
description = Thunder between buildings, the way a phone hears it: the near channel's blast hits first, claps wander over the roofs, then a deep late swell shakes the street.
features = sfx, impact

# Strike
distance = 1.2
height = 6
cloud_spread = 6
tortuosity = 0.5
branching = 0.7
strokes = 3
stroke_gap = 45
variation = 0.4

# Sound
crack = 0.95
weight = 0.55
swell = 0.2
rumble = 0.5
rumble_tone = 0.55
air = 0.35
scatter = 0.5
focus = 0.85
impact = 0.75

# Stereo
width = 0.85
pan = 0
rumble_width = 0.9
drift = 0.3

# Echoes
echo_level = -9
echo_count = 6
echo_spread = 0.9
echo_damping = 0.35

# Space
space_amount = 0.22
space_size = 0.6
space_damping = 0.25

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_key_track = 0

# Envelope
mode = One Shot
attack = 1
release = 1200
storm_rate = 6
vel_to_level = 0.5
vel_to_distance = 0.5

# Output
gain = -13.5
max_shocks = 2048
seed = 0

# Dynamics
compress = 0.55
comp_attack = 2
comp_release = 300

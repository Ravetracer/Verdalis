# ThunderClap preset
format = 1
name = Single Bolt
author = ThunderClap
description = One clean bolt a kilometre off: a single stroke, a single clap, and an honest decay.
features = sfx, impact

# Strike
distance = 1
height = 5
cloud_spread = 2
tortuosity = 0.35
branching = 0.1
strokes = 1
stroke_gap = 60
variation = 0.3

# Sound
crack = 0.6
weight = 0.5
swell = 0.15
rumble = 0.4
rumble_tone = 0.5
air = 0.45
scatter = 0.4
focus = 0.75

# Stereo
width = 0.85
pan = 0
rumble_width = 0.9
drift = 0.3

# Echoes
echo_level = -16
echo_count = 2
echo_spread = 1.2
echo_damping = 0.5

# Space
space_amount = 0.12
space_size = 0.5
space_damping = 0.5

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_key_track = 0

# Envelope
mode = One Shot
attack = 1
release = 1200
storm_rate = 6
vel_to_level = 0.5
vel_to_distance = 0.5

# Output
gain = -3.2
max_shocks = 2048
seed = 0

# Dynamics
compress = 0
comp_attack = 3.16
comp_release = 250

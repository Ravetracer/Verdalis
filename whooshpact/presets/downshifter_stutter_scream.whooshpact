# WhooshPact preset
format = 1
name = Stutter Scream
author = Ravetracer
description = Fitted directly to `Downshifter - Stutter Scream`, which accelerates from 4.1 Hz to 25.0 Hz across its span and is the most strongly periodic thing in the whole 211-file library. A square gate on the level, so it chops rather than wobbles.
features = downshifter, stutter, gate

type = Downshifter
blend = 0
span = 4.2
peak = 0.02
hold = 0.62
rise = 0.6
fall = 1.8
variation = 0.35
noise = White
air_level = -10
air_cutoff = 2600
air_sweep = -4
air_reso = 0.55
air_curve = 1
air_tilt = 0
air_width = 0.3
wave = Saw
tone_level = -13
tone_pitch = 140
tone_glide = -28
tone_detune = 0.3
tone_width = 0.4
pan_start = 0
pan_end = 0
space_amount = 0.2
space_size = 0.45
space_damping = 0.65
space_width = 0.8
sub_level = -5
sub_pitch = 58
sub_drop = -14
sub_decay = 2800
sub_drive = 0.5
sub_click = 0.3
hit_level = -60
hit_tone = 900
hit_decay = 220
hit_noise = 0.6
hit_body = 0.5
hit_time = 0.33
flutter_depth = 0.85
flutter_start = 4.1
flutter_end = 25
flutter_shape = Square
flutter_target = Level
flutter_smooth = 0.3
highpass = 25
lowpass = 5000
eq_low_freq = 90
eq_low_gain = 0
eq_mid_freq = 900
eq_mid_gain = 0
eq_high_freq = 5000
eq_high_gain = 0
attack = 1
decay = 2000
sustain = 1
release = 300
vel_to_level = 0.5
vel_to_tone = 0.3
gain = -2
drive = 0.5
max_voices = 8
seed = 0

# WhooshPact preset
format = 1
name = Deep Whoosh
author = Ravetracer
description = The same gesture an octave and a half down: brown noise, a low corner and a little sub under it. The brown noise and the 900 Hz corner do most of the work -- the sub is trimmed to sit behind them rather than replace them.
features = transition, deep, low

type = Transition
blend = 0
span = 4.2
peak = 0.3
hold = 0.12
rise = 1.6
fall = 2.2
variation = 0.35
noise = Brown
air_level = -4
air_cutoff = 900
air_sweep = -1.8
air_reso = 0.3
air_curve = 2
air_tilt = 0
air_width = 0.55
wave = Saw
tone_level = -60
tone_pitch = 49
tone_glide = -12
tone_detune = 0.25
tone_width = 0.6
pan_start = -0.45
pan_end = 0.45
space_amount = 0.3
space_size = 0.55
space_damping = 0.65
space_width = 0.8
sub_level = -12
sub_pitch = 46
sub_drop = -9
sub_decay = 1400
sub_drive = 0.35
sub_click = 0.2
hit_level = -60
hit_tone = 900
hit_decay = 220
hit_noise = 0.6
hit_body = 0.5
hit_time = 0.33
flutter_depth = 0
flutter_start = 6
flutter_end = 14
flutter_shape = Sine
flutter_target = Level
flutter_smooth = 0.35
highpass = 25
lowpass = 6000
eq_low_freq = 90
eq_low_gain = 3
eq_mid_freq = 900
eq_mid_gain = 0
eq_high_freq = 5000
eq_high_gain = 0
attack = 1
decay = 2000
sustain = 1
release = 300
vel_to_level = 0.5
vel_to_tone = 0.3
gain = -5
drive = 0.12
max_voices = 8
seed = 0

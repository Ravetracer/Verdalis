# WhooshPact preset
format = 1
name = Analog Fall
author = Ravetracer
description = Two octaves of falling saw with the flutter gliding up underneath it, from 3 Hz at the top to 14 by the bottom. The measured median of the family is a doubling; this is closer to five times, which is what the ear reads as falling faster than it is.
features = downshifter, analog, fall

type = Downshifter
blend = 0

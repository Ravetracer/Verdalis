air_reso = 0.55
air_curve = 2.4
air_tilt = 0
air_width = 0.5
wave = Saw
tone_level = -60
tone_pitch = 49
tone_glide = -12
tone_detune = 0.25
tone_width = 0.6
pan_start = -0.1
pan_end = 0.1
space_amount = 0.12
space_size = 0.3
space_damping = 0.5
space_width = 0.8
sub_level = -60
sub_pitch = 49
sub_drop = -12
sub_decay = 700
sub_drive = 0.2
sub_click = 0.3
hit_level = -60
hit_tone = 900
hit_decay = 220

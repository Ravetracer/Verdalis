fall = 4.5
variation = 0.35
noise = White
air_level = -7
air_cutoff = 2000
air_sweep = 1.4
air_reso = 0.4
air_curve = 1.4
air_tilt = 0
air_width = 0.7
wave = Saw
tone_level = -60
tone_pitch = 49

# WhooshPact preset
format = 1
name = Whoosh Hit
author = Ravetracer
description = A whoosh that lands: the noise layer rising to a peak two thirds of the way in and the transient timed to arrive exactly there. The library files fifteen of these under Whoosh Hit, and the timing is the whole trick.
features = transition, whoosh, impact

type = Transition
blend = 0

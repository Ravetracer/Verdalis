# NightLife preset
format = 1
name = Spring Peepers
author = NightLife
description = The high, fast end of the table: `leopard-frogs-croaking.wav`, whose croaks are 43 ms at 3.3 kHz and arrive 480 times a minute -- four times the rate of anything else measured. Twenty-four of them at that rate is a wall, and the shortest croak in the library is what makes it a shimmer rather than a rattle.

# Call
pitch = 893
contour = 0.5
detail = 1
sweep = 100
length = 490
skew = 0.5
jitter = 0.1
vibrato = 0
vibrato_rate = 3.4

# Voice
caller = Wolf
voice = 0.3
breath = 0.06
throat = 19
muzzle = 0.5
formant = 0.55
rasp = 0
radiate = 0.35
partials = 0.6

# Phrase
calls = 3
call_rate = 0.98
rate_drift = 0
legato = 0.32
motif = 0
variation = 0.3
phrase_gap = 3.7
repeats = 1

# Pack
shot_level = -60
pack_level = -60

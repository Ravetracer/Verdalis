# NightLife preset
format = 1
name = Pond Chorus
author = NightLife
description = Sixteen frogs on one pond. Every number is one row of the croak table -- `frogs-6.wav`, measured at a 20 Hz pulse rate, thirteen pulses, a 608 ms croak and resonances at 1535 and 442 Hz -- and Chorus Spread puts the pond's other species around it. Regularity is at 0.95, which is not a taste judgement: the measured Fano factor of croak arrivals is 0.30 at four seconds where a Poisson process is 1.0, and this is the setting that renders it.

# Call
pitch = 893
contour = 0.5
detail = 1
sweep = 100
length = 490
skew = 0.5
jitter = 0.1
vibrato = 0
vibrato_rate = 3.4

# Voice
caller = Wolf
voice = 0.3
breath = 0.06
throat = 19
muzzle = 0.5
formant = 0.55
rasp = 0
radiate = 0.35
partials = 0.6

# Phrase
calls = 3
call_rate = 0.98
rate_drift = 0
legato = 0.32
motif = 0
variation = 0.3
phrase_gap = 3.7
repeats = 1

# Pack
shot_level = -60
pack_level = -60
pack_rate = 30
animals = 3
pitch_spread = 0.5
voice_spread = 0.35
answer = 0.45
restless = 0.4
max_voices = 24

# Chorus
chorus_level = -2
croak = 0.44
croak_pitch = 1535
pulse_rate = 20
pulses = 13
croak_length = 608
frogs = 16
croak_rate = 48
regularity = 0.95
chorus_spread = 0.8
chorus_width = 0.95

# Insects
insect_level = -26
insect_pitch = 2982
insect_width = 0.35
trill_rate = 49.2
trill_depth = 0.7
shimmer = 0.5

# Bed
bed_level = -24
bed_tilt = 0
bed_motion = 0.3

# Place
distance = 0.3
distance_spread = 0.45
air = 0.55
width = 0.7
space_amount = 0.35
space_size = 0.7
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 400
decay = 400
sustain = 1
release = 2500
vel_to_level = 0.6
vel_to_pitch = 0.15

# Output
gain = -3
seed = 0

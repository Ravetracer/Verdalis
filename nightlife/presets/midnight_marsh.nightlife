# NightLife preset
format = 1
name = Midnight Marsh
author = NightLife
description = A wet place with something large a long way off. The chorus is the two-pulse creak of `croaking-frogs.wav` at 13 Hz, eighteen of them; the wolf calls about once every fifteen seconds and three animals answer each other at 0.7. Everything is far away -- Distance 0.6, Depth 0.55 -- which is what makes the space rather than the reverb.

# Call
pitch = 455
contour = 0.5
detail = 1
sweep = 100
length = 1400
skew = 0.5
jitter = 0.1
vibrato = 0
vibrato_rate = 3.4

# Voice
caller = Wolf
voice = 0.26
breath = 0.06
throat = 26
muzzle = 0.5
formant = 0.55
rasp = 0
radiate = 0.35
partials = 0.6

# Phrase
calls = 1
call_rate = 0.98
rate_drift = 0
legato = 0
motif = 0
variation = 0.4
phrase_gap = 3.7
repeats = 1

# Pack
shot_level = -6
pack_level = -18
pack_rate = 4
animals = 3
pitch_spread = 0.6
voice_spread = 0.35
answer = 0.7
restless = 0.65
max_voices = 24

# Chorus
chorus_level = -10
croak = 0.31
croak_pitch = 1529
pulse_rate = 13
pulses = 2
croak_length = 192
frogs = 18
croak_rate = 110
regularity = 0.95
chorus_spread = 0.9
chorus_width = 1.0

# Insects
insect_level = -20
insect_pitch = 2800
insect_width = 0.35
trill_rate = 33
trill_depth = 0.8
shimmer = 0.65

# Bed
bed_level = -20
bed_tilt = -0.2
bed_motion = 0.4

# Place
distance = 0.6
distance_spread = 0.55
air = 0.45
width = 0.85
space_amount = 0.55
space_size = 0.9
space_damping = 0.45

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 900
decay = 400
sustain = 1
release = 5000
vel_to_level = 0.6
vel_to_pitch = 0.15

# Output
gain = 9
seed = 0

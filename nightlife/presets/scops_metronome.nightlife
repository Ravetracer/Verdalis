# NightLife preset
format = 1
name = Scops Metronome
author = NightLife
description = One pip every two and a half seconds, for as long as you hold the note. The scops owl recording is 105 seconds of exactly that -- 42 calls at a median 1272 Hz whose measured contour barely moves, a sweep of 0.04 octaves, the flattest thing in the library. Variation is almost off because that is the point of the bird. The insect bed under it is from the same recording, which carries a cricket band at 3.2 kHz.

# Call
pitch = 1272
contour = 0.6
detail = 1
sweep = 100
length = 907
skew = 0.5
jitter = 0.05
vibrato = 0
vibrato_rate = 3.4

# Voice
caller = Scops
voice = 0.12
breath = 0.03
throat = 12
muzzle = 0.3
formant = 0.5
rasp = 0
radiate = 0.35
partials = 0.75

# Phrase
calls = 1
call_rate = 0.98
rate_drift = 0
legato = 0
motif = 0
variation = 0.08
phrase_gap = 2.6
repeats = 16

# Pack
shot_level = 4
pack_level = -10
pack_rate = 24
animals = 1
pitch_spread = 0.5
voice_spread = 0.35
answer = 0.45
restless = 0.4
max_voices = 24

# Chorus
chorus_level = -60
croak = 0.5
croak_pitch = 2063
pulse_rate = 27
pulses = 10
croak_length = 325
frogs = 12
croak_rate = 121
regularity = 0.95
chorus_spread = 0.7
chorus_width = 0.85

# Insects
insect_level = -22
insect_pitch = 2982
insect_width = 0.35
trill_rate = 42
trill_depth = 0.7
shimmer = 0.5

# Bed
bed_level = -26
bed_tilt = 0
bed_motion = 0.3

# Place
distance = 0.5
distance_spread = 0.2
air = 0.5
width = 0.4
space_amount = 0.4
space_size = 0.65
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 9.76
decay = 400
sustain = 1
release = 2500
vel_to_level = 0.6
vel_to_pitch = 0.15

# Output
gain = 0
seed = 0

# NightLife preset
format = 1
name = Deep Forest Bed
author = NightLife
description = Nothing calls. This is the measured night on its own -- the third-octave curve of the quietest third of the frames of all 45 references, solved onto an eight-band filterbank and then corrected against the engine's own rendered curve until it sat within 3.9 dB rms of it. Bed Tilt pulls it darker, which is what standing under a canopy does.

# Call
pitch = 893
contour = 0.5
detail = 1
sweep = 100
length = 490
skew = 0.5
jitter = 0.1
vibrato = 0
vibrato_rate = 3.4

# Voice
caller = Wolf
voice = 0.3
breath = 0.06
throat = 19
muzzle = 0.5
formant = 0.55
rasp = 0
radiate = 0.35
partials = 0.6

# Phrase
calls = 3
call_rate = 0.98
rate_drift = 0
legato = 0.32
motif = 0
variation = 0.3
phrase_gap = 3.7
repeats = 1

# Pack
shot_level = -60
pack_level = -60
pack_rate = 30
animals = 3
pitch_spread = 0.5
voice_spread = 0.35
answer = 0.45
restless = 0.4
max_voices = 24

# Chorus
chorus_level = -60
croak = 0.5
croak_pitch = 2063
pulse_rate = 27
pulses = 10
croak_length = 325
frogs = 12
croak_rate = 121
regularity = 0.95
chorus_spread = 0.7
chorus_width = 0.85

# Insects
insect_level = -22
insect_pitch = 2600
insect_width = 0.45
trill_rate = 28
trill_depth = 0.5
shimmer = 0.75

# Bed
bed_level = -8
bed_tilt = -0.3
bed_motion = 0.5

# Place
distance = 0.55
distance_spread = 0.45
air = 0.5
width = 0.85
space_amount = 0.45
space_size = 0.8
space_damping = 0.75

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 1500
decay = 400
sustain = 1
release = 4000
vel_to_level = 0.6
vel_to_pitch = 0.15

# Output
gain = 1
seed = 0

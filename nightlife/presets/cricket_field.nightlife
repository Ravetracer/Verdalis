# NightLife preset
format = 1
name = Cricket Field
author = NightLife
description = The insect bed on its own, which is the weakest measurement in the plugin and says so. The library has no recording of insects alone: the carrier and the trill rate here come from the cricket band *behind* a scops owl and behind a chorus of frogs, isolated by being narrow, high and steady where everything else in those files is none of the three. 2.9 to 3.2 kHz, pulsed at 49 Hz.

# Call
pitch = 893
contour = 0.5
detail = 1
sweep = 100
length = 490
skew = 0.5
jitter = 0.1
vibrato = 0
vibrato_rate = 3.4

# Voice
caller = Wolf
voice = 0.3
breath = 0.06
throat = 19
muzzle = 0.5
formant = 0.55
rasp = 0
radiate = 0.35
partials = 0.6

# Phrase
calls = 3
call_rate = 0.98
rate_drift = 0
legato = 0.32
motif = 0
variation = 0.3
phrase_gap = 3.7
repeats = 1

# Pack
shot_level = -60
pack_level = -60
pack_rate = 30
animals = 3
pitch_spread = 0.5
voice_spread = 0.35
answer = 0.45
restless = 0.4
max_voices = 24

# Chorus
chorus_level = -60
croak = 0.5
croak_pitch = 2063
pulse_rate = 27
pulses = 10
croak_length = 325
frogs = 12
croak_rate = 121
regularity = 0.95
chorus_spread = 0.7
chorus_width = 0.85

# Insects
insect_level = -4
insect_pitch = 3164
insect_width = 0.25
trill_rate = 49
trill_depth = 0.75
shimmer = 0.6

# Bed
bed_level = -18
bed_tilt = 0.15
bed_motion = 0.35

# Place
distance = 0.3
distance_spread = 0.45
air = 0.5
width = 0.9
space_amount = 0.25
space_size = 0.5
space_damping = 0.7

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 800
decay = 400
sustain = 1
release = 2500
vel_to_level = 0.6
vel_to_pitch = 0.15

# Output
gain = -7
seed = 0

# RainyDay preset
format = 1
name = First Drops
author = RainyDay
description = The first scattered drops hitting dry pavement before the real rain arrives.
features = ambient, texture, sparse, foley

# Rain
density = 14
clumping = 0.55
drop_pitch = 5873
pitch_spread = 3.18
drop_decay = 21.8
decay_spread = 0.5
tonality = 0.411
bubble = 0.86
impact = 0.824
splash = 0.047
slosh = 0
level_spread = 0.6
chirp = 0.35
surface = Concrete
note_tracking = 0.5

# Bed
bed_level = -12.2
bed_tone = 0.69
bed_body = 0
bed_drift = 0.3
bed_width = 0.9
bed_pan = 0

# Space
width = 0.9
drop_pan = 0
distance = 0.327
air = 0.684
space_amount = 0.25
space_size = 0.55
space_damping = 0.5

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_key_track = 0

# Envelope
attack = 60
decay = 600
sustain = 1
release = 1600
vel_to_level = 0.5
vel_to_density = 0.3

# Trickle: drops landing on a hard surface. The same layer, and the
# same eight controls, as RiverFlow's Trickle.
trickle_level = -27.5
trickle_rate = 6
trickle_size = 1.30
trickle_spread = 1.0
trickle_decay = 14
trickle_impact = 60
stone_tone = 5600
trickle_splash = 22

# Output
gain = 1.64
max_droplets = 512
seed = 0

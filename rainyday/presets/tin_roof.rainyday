# RainyDay preset
format = 1
name = Tin Roof
author = RainyDay
description = Rain on corrugated metal. Every impact rings with a bright metallic pitch.
features = ambient, texture, metallic, bright

# Rain
density = 514
clumping = 0.365
drop_pitch = 1623
pitch_spread = 3.65
drop_decay = 2.57
decay_spread = 0.817
tonality = 0.268
bubble = 0.327
impact = 0.977
splash = 0.899
slosh = 0.5
level_spread = 1
chirp = 0.35
surface = Metal
note_tracking = 0.5

# Bed
bed_level = -25
bed_tone = 0.433
bed_body = 0.023
bed_drift = 0.193
bed_width = 0.85
bed_pan = 0

# Space
width = 0.85
drop_pan = 0
distance = 0.128
air = 0.892
space_amount = 0.25
space_size = 0.35
space_damping = 0.3

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_key_track = 0

# Envelope
attack = 300
decay = 600
sustain = 1
release = 1800
vel_to_level = 0.5
vel_to_density = 0.3

# Trickle: drops landing on a hard surface. The same layer, and the
# same eight controls, as RiverFlow's Trickle.
trickle_level = -36
trickle_rate = 20
trickle_size = 0.95
trickle_spread = 1.2
trickle_decay = 9
trickle_impact = 45
stone_tone = 6200
trickle_splash = 20

# Output
gain = 1.49
max_droplets = 512
seed = 0

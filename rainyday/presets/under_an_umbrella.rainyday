# RainyDay preset
format = 1
name = Under an Umbrella
author = RainyDay
description = Rain drumming on a taut canopy a foot above your head. Close, blunt and percussive.
features = ambient, texture, close, percussive

# Rain
density = 900
clumping = 0.305
drop_pitch = 1200
pitch_spread = 2.6
drop_decay = 12
decay_spread = 0.6
tonality = 0.12
bubble = 0.35
impact = 0.9
splash = 0.55
level_spread = 0.55
chirp = 0.35
surface = Fabric
note_tracking = 0.5

# Bed
bed_level = -26
bed_tone = 0.5
bed_body = 0.1
bed_drift = 0.35
bed_width = 0.8
bed_pan = 0

# Space
width = 0.8
drop_pan = 0
distance = 0.05
air = 0.15
space_amount = 0.12
space_size = 0.25
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_key_track = 0

# Envelope
attack = 400
decay = 600
sustain = 1
release = 1600
vel_to_level = 0.5
vel_to_density = 0.3

# Output
gain = 0.736
max_droplets = 512
seed = 0

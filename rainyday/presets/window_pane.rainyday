# RainyDay preset
format = 1
name = Window Pane
author = RainyDay
description = Close-up rain against glass. Hard, bright, glassy ticks right in front of you.
features = ambient, texture, bright, glassy, close

# Rain
density = 1174
clumping = 0
drop_pitch = 406
pitch_spread = 0.001
drop_decay = 3.17
decay_spread = 0
tonality = 0.709
bubble = 0.934
impact = 0.477
splash = 0.751
slosh = 0.35
level_spread = 0.236
chirp = 0.35
surface = Glass
note_tracking = 0.5

# Bed
bed_level = -21.3
bed_tone = 1
bed_body = 0.442
bed_drift = 0.58
bed_width = 0.7
bed_pan = 0

# Space
width = 0.7
drop_pan = 0
distance = 0.899
air = 0
space_amount = 0.15
space_size = 0.3
space_damping = 0.5

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 14000
filter_reso = 0.1
filter_key_track = 0

# Envelope
attack = 250
decay = 600
sustain = 1
release = 1500
vel_to_level = 0.5
vel_to_density = 0.3

# Trickle: drops landing on a hard surface. The same layer, and the
# same eight controls, as RiverFlow's Trickle.
trickle_level = -28.4
trickle_rate = 16
trickle_size = 0.80
trickle_spread = 1.2
trickle_decay = 8
trickle_impact = 0.60
stone_tone = 7400
trickle_splash = 0.18

# Output
gain = 4.05
max_droplets = 512
seed = 0

# ShoreBreak preset
format = 1
name = Shallow Clear Water
author = ShoreBreak
description = Sparse, isolated laps in shallow water, with real silence between them. The reference's 41 dB crest factor is the highest in the library.
features = sparse, quiet, clear

# Surf
wave_period = 6500
set_variation = 0.6
wave_size = 0.22
size_variation = 0.6
break_attack = 500
break_decay = 450
break_tone = 1000
break_body = 0.12
crest_sweep = 0.16

# ShoreBreak preset
format = 1
name = Receding Sand
author = ShoreBreak
description = The drain: water running back down the beach through the sand it just covered. Wash does most of the work here, and the break is only what starts it.
features = wash, texture, drain

# Surf
wave_period = 4200
set_variation = 0.4
wave_size = 0.35
size_variation = 0.5
break_attack = 300
break_decay = 300
break_tone = 900
break_body = 0.1
crest_sweep = 0.18
breaker_type = Spilling
bubble_mix = 0.26
precursor = 0.3

# Foam
foam_level = -15
foam_decay = 1800
foam_tone = 2200
foam_delay = 300
foam_bubbles = 0.5
fizz = 0.34

# Swell
swell_level = -34
swell_tone = 800
swell_depth = 0.55
swell_rate = 9
swell_width = 0.9

# Bubbles
bubble_rate = 30
bubble_pitch = 1010
bubble_spread = 1.2
bubble_decay = 1

# Wash
wash_level = -5
wash_decay = 3200
wash_tone = 1300
sand = 0.85

# Shore
shore_type = Shingle
distance = 0.12
air = 0.7
width = 0.85
space_amount = 0.32
space_size = 0.62
space_damping = 0.5

# Filter
filter_type = Lowpass
highpass = 90
filter_cutoff = 20000
filter_reso = 0.05
filter_keytrack = 0

# Envelope
attack = 1000
decay = 500
sustain = 1
release = 2600
vel_to_level = 0.4
vel_to_size = 0.3

# Output
gain = 0
max_waves = 144
seed = 0

# ShoreBreak preset
format = 1
name = Turmoil Fjord
author = ShoreBreak
description = Confined water in turmoil, the walls giving it back. The reference's crest factor of 21 dB is nearly continuous sound, so the swell carries most of it.
features = fjord, dense, dark

# Surf
wave_period = 2800
set_variation = 0.6
wave_size = 0.7
size_variation = 0.6
break_attack = 550
break_decay = 1000
break_tone = 480
break_body = 0.85
crest_sweep = 0.5
breaker_type = Collapsing
precursor = 0.35

# Foam
foam_level = -10
foam_decay = 3000
foam_tone = 700
foam_delay = 250
fizz = 0.25

# Swell
swell_level = -9
swell_tone = 300

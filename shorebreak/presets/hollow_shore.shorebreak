# ShoreBreak preset
format = 1
name = Hollow Shore
author = ShoreBreak
description = A shore that rings: water working into a hollow under rock, so the space is a bigger part of the sound than the break is.
features = cave, resonant, space

# Surf
wave_period = 4600

# ShoreBreak preset
format = 1
name = Tidal Swells
author = ShoreBreak
description = Long swells arriving without properly breaking: they surge up the shore and run back. The slowest attack in the library, at over a second.
features = swell, slow, deep

# Surf
wave_period = 5200
set_variation = 0.35
wave_size = 0.65
size_variation = 0.4
break_attack = 1200
break_decay = 900
break_tone = 620
break_body = 0.75
crest_sweep = 0.1
breaker_type = Surging
bubble_mix = 0.04
precursor = 0.2

# Foam
foam_level = -19
foam_decay = 2400
foam_tone = 1200
foam_delay = 800
foam_bubbles = 0.1
fizz = 0.2

# Swell
swell_level = -13
swell_tone = 520
swell_depth = 0.5
swell_rate = 4
swell_width = 0.95

# Bubbles
bubble_rate = 12
bubble_pitch = 845
bubble_spread = 1
bubble_decay = 1

# Wash
wash_level = -15
wash_decay = 3000
wash_tone = 650
sand = 0.35

# Shore
shore_type = Sand
distance = 0.35
air = 0.45
width = 0.88
space_amount = 0.42
space_size = 0.8
space_damping = 0.55

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 11000
filter_reso = 0.05
filter_keytrack = 0

# Envelope
attack = 2500
decay = 1200
sustain = 1
release = 4500
vel_to_level = 0.4
vel_to_size = 0.35

# Output
gain = 0
max_waves = 112
seed = 0

# SkyHowl preset
format = 1
name = River Reeds
author = SkyHowl
description = Wind through reeds at a waterside. Hollow stems knock rather than brush, so the decay is long and the clatter high, and the whole thing sits on a very low bed -- the reference peaks at 63 Hz and is 24 dB down by 500.
features = reeds, water, hollow, low

# Wind
wind_speed = 7
turbulence = 11
gust_rate = 1.2
gust_depth = 0.5
gust_length = 10000
gust_shape = 0.5
squall = 0.35
squall_rate = 1

# Airflow
flow_level = -40
flow_tone = 2600
flow_tilt = -2
buffet = -4
buffet_tone = 40
hiss = 0.45
speed_law = 1

# Howl
howl_amount = 0.2
obstacle = Reeds
howl_size = 4
howl_spread = 0.8
howl_voices = 5
howl_reso = 0.5
howl_track = 0.9
howl_threshold = 0.3
warble = 0.25

# Rustle
rustle_amount = 0.4
foliage = Reeds
rustle_size = 23
rustle_density = 22
rustle_spread = 1.2
rustle_decay = 45
rustle_threshold = 0.2
clatter = 0.55

# Place
terrain = Coast
distance = 0.2
air = 0.5
width = 0.5
space_amount = 0.2
space_size = 0.5
space_damping = 0.5

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2500
decay = 800
sustain = 1
release = 4000
vel_to_level = 0.5
vel_to_speed = 0.4

# Output
gain = 0
max_gusts = 64
seed = 0

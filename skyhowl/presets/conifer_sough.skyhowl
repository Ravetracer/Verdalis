# SkyHowl preset
format = 1
name = Conifer Sough
author = SkyHowl
description = The sough of wind in pines: needles are small and there are millions of them, so instead of separate leaves there is a continuous merged hiss. The reference runs 260 onsets a second at the lowest flux variation in the library -- 0.20, which is what merged means -- over a very heavy low end.
features = forest, conifer, sough, hiss

# Wind
wind_speed = 9
turbulence = 7
gust_rate = 4.7
gust_depth = 0.6
gust_length = 4500
gust_shape = 0.5
squall = 0.4
squall_rate = 1.2

# Airflow
flow_level = -36
flow_tone = 900
flow_tilt = -5
buffet = -4
buffet_tone = 38
hiss = 0.9
speed_law = 1

# Howl
howl_amount = 0.1
obstacle = Twigs
howl_size = 3
howl_spread = 1.8
howl_voices = 6
howl_reso = 0.3
howl_track = 0.8
howl_threshold = 0.3
warble = 0.25

# Rustle
rustle_amount = 0.05
foliage = Conifer
rustle_size = 51
rustle_density = 140
rustle_spread = 0.8
rustle_decay = 6
rustle_threshold = 0.15
clatter = 0.05

# Place
terrain = Forest
distance = 0.2
air = 0.5
width = 0.4
space_amount = 0.3
space_size = 0.6
space_damping = 0.7

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2500
decay = 800
sustain = 1
release = 4000
vel_to_level = 0.5
vel_to_speed = 0.4

# Output
gain = 0
max_gusts = 64
seed = 0

# VerdaliScene preset
format = 1
name = Mountain Stream
author = VerdaliScene
description = High up, where a cold stream drops between boulders: wind along the ridge and a few birds on the tree line far below.
features = ambient, nature, mountain, water, wind, birds

# Envelope

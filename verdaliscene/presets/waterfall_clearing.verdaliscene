decay = 1000
sustain = 1
release = 4000

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1

# Output
width = 1
gain = 0

layer = RiverFlow
layer_from = Big Falls
layer_level = -6.5

layer = ChirpParade
layer_from = Dawn Chorus
layer_level = -0.5

layer = InsectSwarm
layer_from = Dragonfly Pond
layer_level = -18.5
layer_pan = 0.4

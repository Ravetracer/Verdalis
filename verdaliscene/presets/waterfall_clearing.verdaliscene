# VerdaliScene preset
format = 1
name = Waterfall Clearing
author = VerdaliScene
description = A clearing beside a waterfall on a spring morning: the roar of the fall, a dawn chorus in the trees around it and dragonflies over the pool.
features = ambient, nature, water, birds, insects, morning

# Envelope

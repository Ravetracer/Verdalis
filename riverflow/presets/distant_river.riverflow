# RiverFlow preset
format = 1
name = Distant River
author = RiverFlow
description = The same water from further off. Nothing is countable any more: distance multiplies the events and smears their edges until they are the roar.
features = creek, close

# Flow
water_type = Creek
water_blend = 0.95
flow_level = -24
flow_tilt = 0.04
flow_body = 0.47
turbulence = 0.10
surge_rate = 2.58
flow_grain = 0.00

# Stones
dabble_rate = 5.50
dabble_level = -55.0
dabble_size = 3.30
dabble_spread = 0.9
dabble_cluster = 4
dabble_spill = 25
dabble_damping = 1
dabble_glug = 0.35

# Trickle
trickle_rate = 16.00
trickle_level = -48.1
trickle_size = 1.24
trickle_spread = 1.2
trickle_decay = 13
trickle_impact = 0.45
stone_tone = 3500
splash = 0.25

# Plunge
plunge_level = -44
plunge_tone = 120
plunge_depth = 0.3
plunge_q = 0.4

# Reach
bank_type = Open
distance = 0.32
air = 0.5
width = 0.70
flow_width = 0.59
space_amount = 0.3
space_size = 0.85
space_damping = 0.45

# Filter
filter_type = Lowpass
highpass = 60
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 800
decay = 500
sustain = 1
release = 1500
vel_to_level = 0.4
vel_to_flow = 0.3

# Output
gain = 6.0
max_events = 512
seed = 0

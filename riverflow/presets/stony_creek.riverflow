# RiverFlow preset
format = 1
name = Stony Creek
author = RiverFlow
description = A creek over bare stone. Grainy in every band at once, and bright with it.
features = creek, tickling, close

# Flow
water_type = Creek
water_blend = 0.75
flow_level = -24
flow_tilt = -0.08
flow_body = 0.89
turbulence = 1.00
surge_rate = 1.09
flow_grain = 0.00

# Stones
dabble_rate = 11.33
dabble_level = -20.7
dabble_size = 3.39
dabble_spread = 0.30
dabble_cluster = 4
dabble_spill = 25
dabble_damping = 1
dabble_glug = 0.35

# Trickle
trickle_rate = 33.54
trickle_level = -12.4
trickle_size = 1.81
trickle_spread = 1.2
trickle_decay = 13
trickle_impact = 0.45
stone_tone = 3500
splash = 0.25

# Plunge
plunge_level = -50
plunge_tone = 220
plunge_depth = 0.35
plunge_q = 0.6

# Reach
bank_type = Rock Pool
distance = 0.08
air = 0.5
width = 0.00
flow_width = 0.00
space_amount = 0.26
space_size = 0.35
space_damping = 0.4

# Filter
filter_type = Lowpass
highpass = 60
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 800
decay = 500
sustain = 1
release = 1500
vel_to_level = 0.4

# RiverFlow preset
format = 1
name = Wild River
author = RiverFlow
description = A river running hard through woodland. One of the library's smoothest recordings -- statistically it is shaped noise, and this preset is honest about that.
features = creek, close

# Flow
water_type = Creek
water_blend = 0.55
flow_level = -24
flow_tilt = 0.07
flow_body = 0.54
turbulence = 0.10
surge_rate = 0.39
flow_grain = 0.00

# Stones
dabble_rate = 5.50
dabble_level = -55.0
dabble_size = 3.30
dabble_spread = 0.9
dabble_cluster = 4
dabble_spill = 25
dabble_damping = 1
dabble_glug = 0.35

# Trickle
trickle_rate = 16.00
trickle_level = -48.1
trickle_size = 1.24
trickle_spread = 1.2
trickle_decay = 13
trickle_impact = 0.45
stone_tone = 3500
splash = 0.25

# Plunge
plunge_level = -38
plunge_tone = 140
plunge_depth = 0.45
plunge_q = 0.5

# Reach
bank_type = Forest
distance = 0.26
air = 0.5
width = 1.00
flow_width = 1.00
space_amount = 0.24
space_size = 0.6
space_damping = 0.55

# Filter
filter_type = Lowpass
highpass = 60
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 800
decay = 500
sustain = 1
release = 1500
vel_to_level = 0.4
vel_to_flow = 0.3

# Output
gain = 0
max_events = 512
seed = 0

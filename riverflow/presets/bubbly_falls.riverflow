# RiverFlow preset
format = 1
name = Bubbly Falls
author = RiverFlow
description = The bubbliest recording in the library. Almost all of this is countable events; the bed is barely there under them.
features = trickle, tickling, close

# Flow
water_type = Trickle
water_blend = 0.45
flow_level = -24
flow_tilt = 0.22
flow_body = 0.53
turbulence = 0.78
surge_rate = 2.50
flow_grain = 0.00

# Stones
dabble_rate = 23.33
dabble_level = -23.4
dabble_size = 3.16
dabble_spread = 0.30
dabble_cluster = 4
dabble_spill = 25
dabble_damping = 1
dabble_glug = 0.35

# Trickle
trickle_rate = 50.99
trickle_level = -11.3
trickle_size = 0.77
trickle_spread = 1.2
trickle_decay = 13
trickle_impact = 0.45
stone_tone = 3500
splash = 0.25

# Plunge
plunge_level = -44
plunge_tone = 180
plunge_depth = 0.4
plunge_q = 0.65

# Reach
bank_type = Rock Pool
distance = 0.08
air = 0.5
width = 0.62
flow_width = 0.52
space_amount = 0.3
space_size = 0.4
space_damping = 0.42

# Filter
filter_type = Lowpass
highpass = 60
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 800
decay = 500
sustain = 1
release = 1500
vel_to_level = 0.4
vel_to_flow = 0.3

# Output
gain = -12.3
max_events = 512
seed = 0

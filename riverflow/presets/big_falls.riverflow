# RiverFlow preset
format = 1
name = Big Falls
author = RiverFlow
description = A big fall into a plunge pool. The weight underneath is the collective modes of the bubble cloud the falling water holds down there, not the bed.
features = deep-rush, close

# Flow
water_type = Deep Rush
water_blend = 0.95
flow_level = -24
flow_tilt = -0.02
flow_body = 0.73
turbulence = 0.13
surge_rate = 4.14
flow_grain = 0.00

# Stones
dabble_rate = 5.50
dabble_level = -55.0
dabble_size = 3.30
dabble_spread = 0.9
dabble_cluster = 4
dabble_spill = 25
dabble_damping = 1
dabble_glug = 0.35

# Trickle
trickle_rate = 16.00
trickle_level = -48.1
trickle_size = 1.24
trickle_spread = 1.2
trickle_decay = 13
trickle_impact = 0.45
stone_tone = 3500
splash = 0.25

# Plunge
plunge_level = -26
plunge_tone = 90
plunge_depth = 0.55
plunge_q = 0.65

# Reach
bank_type = Gorge
distance = 0.30
air = 0.5
width = 0.11
flow_width = 0.10
space_amount = 0.36
space_size = 0.7
space_damping = 0.38

# Filter
filter_type = Lowpass
highpass = 60
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 800
decay = 500
sustain = 1
release = 1500
vel_to_level = 0.4
vel_to_flow = 0.3

# Output
gain = 0
max_events = 512
seed = 0

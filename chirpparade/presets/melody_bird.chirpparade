# ChirpParade preset
format = 1
name = Melody Bird
author = ChirpParade
description = For playing tunes with. One syllable a note and hardly any variation, on the flattest of the whistler contours with Sweep pulled down, so the pitch that comes out is the pitch of the key -- the contour is measured about its own centre and Pitch transposes it, which is what makes that true. Velocity moves the pitch as well as the level, the way a bird calling harder goes up.
features = playable, keyboard, tuned, one shot
# fit harmonics=1

# Syllable
pitch = 2580
sweep = 35
contour = 0.55
detail = 1
length = 140
skew = 0.5
jitter = 0.05
pulse_rate = 13.2
pulse_depth = 0

# Timbre
species = Whistler
voice = 0
breath = 0.05
tract = 4.9
beak = 0.5
formant = 0.55
rasp = 0
radiate = 0.35

# Phrase
syllables = 1
syllable_rate = 7.5
rate_drift = 0
legato = 0.7
motif = 0
variation = 0.1
phrase_gap = 0.31
repeats = 1

# Flock
shot_level = 0
flock_level = -60
flock_rate = 273
birds = 1
pitch_spread = 0
voice_spread = 0.3
answer = 0.35
restless = 0.4
max_voices = 24

# Drum
drum_level = -60
drum_rate = 6
strikes = 10
strike_rate = 15
drum_accel = 0.23
knock = 1000
ring = 13

# Place
distance = 0.1
distance_spread = 0
air = 0.5
width = 0.6
space_amount = 0.25
space_size = 0.5
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0.6

# Envelope
attack = 2
decay = 400
sustain = 1
release = 600
vel_to_level = 0.6
vel_to_pitch = 0.35

# Output
gain = -3
seed = 0

# ChirpParade preset
format = 1
name = Jungle Screech
author = ChirpParade
description = The one species with no reference of its own. Screech borrows the eight most extreme contours in the whole library -- the ones whose pitch travels furthest, 7.5 to 10.3 octaves of path -- which is what 'every range at once' honestly means when there is nothing to measure. Kept because a plugin for birds should be able to make a noise no bird makes.

# Syllable
pitch = 3400
sweep = 160
contour = 0.8
detail = 1
length = 260
skew = 0.5
jitter = 0.12
pulse_rate = 13.2
pulse_depth = 0

# Timbre
species = Screech
voice = 0.45
breath = 0.0735
tract = 4.9
beak = 0.5
formant = 0.55
rasp = 0.5
radiate = 0.35
partials = 0.3

# Phrase
syllables = 2
syllable_rate = 3
rate_drift = 0
legato = 0.7
motif = 0
variation = 0.35
phrase_gap = 0.31
repeats = 1

# Flock
shot_level = -4
flock_level = -10
flock_rate = 90
birds = 4
pitch_spread = 1.8
voice_spread = 0.5
answer = 0.35
restless = 0.4
max_voices = 24

# Drum
drum_level = -60
drum_rate = 6
strikes = 10
strike_rate = 15
drum_accel = 0.23
knock = 1000
ring = 13

# Place
distance = 0.3
distance_spread = 0.4
air = 0.5
width = 0.6
space_amount = 0.4
space_size = 0.7
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2
decay = 400
sustain = 1
release = 600
vel_to_level = 0.6
vel_to_pitch = 0.2

# Output
gain = 6.6
seed = 0

# ChirpParade preset
format = 1
name = Cuckoo Call
author = ChirpParade
description = The common cuckoo, from four references of the bird calling in a wood: 38 whole calls, each a short "cu" at 665 Hz and a longer "coo" 4.2 semitones below it -- a major third -- one call every 1.2 s. One harmonic and -37 dB of spectral flatness, the purest voice in the library. Cuckoo plays its two measured notes in turn, Motif is the measured fall, and a note starts a run of eight calls. The references' echo of each note, 15 to 30 dB down for 170 ms, is the Space here.
# fit harmonics=1 rough=-37

# Syllable
pitch = 2580
sweep = 100
contour = 0.5
detail = 1
length = 96
skew = 0.5
jitter = 0.04
pulse_rate = 13.2
pulse_depth = 0

# Timbre
species = Cuckoo
voice = 0
breath = 0.05
tract = 13
beak = 0.15
formant = 0.4
rasp = 0
radiate = 0.12
partials = 0.6

# Phrase
syllables = 2
syllable_rate = 3.45
rate_drift = 0
legato = 0
motif = -4.2
variation = 0.08
phrase_gap = 0.89
repeats = 8

# Flock
shot_level = 0
flock_level = -6
flock_rate = 22
birds = 2
pitch_spread = 0.12
voice_spread = 0.1
answer = 0.2
restless = 0.2
max_voices = 24

# Drum
drum_level = -60
drum_rate = 6
strikes = 10
strike_rate = 15
drum_accel = 0.23
knock = 1000
ring = 13

# Place
distance = 0.3
distance_spread = 0.3
air = 0.5
width = 0.5
space_amount = 0.15
space_size = 0.5
space_damping = 0.55

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2
decay = 400
sustain = 1
release = 600
vel_to_level = 0.6
vel_to_pitch = 0.2

# Output
gain = 0
seed = 0

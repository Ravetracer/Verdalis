# ChirpParade preset
format = 1
name = Garden Sparrows
author = ChirpParade
description = The library median, made audible. Every value here is the middle of the 4287 syllables measured across the reference library: a 2.6 kHz syllable of 96 ms sweeping 0.35 of an octave over a quarter turn of contour, three of them to a phrase at seven and a half a second, five birds at a spread of 0.8 octaves. It is the starting point rather than a destination, and it is the only preset that changes nothing.
features = garden, day, flock, bright
# fit pitch=3172 length=125 harmonics=1 rough=-29

# Syllable
pitch = 2600
sweep = 0.35
contour = 0.25
turns = 0.25
length = 96
skew = 0.37
jitter = 0.12
pulse_rate = 13.2
pulse_depth = 0.2

# Timbre
species = Sparrow
voice = 0.3
breath = 0.1
tract = 4.9
beak = 0.5
formant = 0.55
rasp = 0
radiate = 0.35

# Phrase
syllables = 3
syllable_rate = 7.5
rate_drift = 0
legato = 0.7
motif = 0
variation = 0.35
phrase_gap = 0.31
repeats = 1

# Flock
shot_level = 0
flock_level = -12
flock_rate = 273
birds = 5
pitch_spread = 0.8
voice_spread = 0.3
answer = 0.35
restless = 0.4
max_voices = 24

# Drum
drum_level = -60
drum_rate = 6
strikes = 10
strike_rate = 15
drum_accel = 0.23
knock = 1000
ring = 13

# Place
distance = 0.35
distance_spread = 0.4
air = 0.5
width = 0.6
space_amount = 0.25
space_size = 0.55
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2
decay = 400
sustain = 1
release = 600
vel_to_level = 0.6
vel_to_pitch = 0.2

# Output
gain = 6
seed = 0

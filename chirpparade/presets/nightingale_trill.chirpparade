# ChirpParade preset
format = 1
name = Nightingale Trill
author = ChirpParade
description = Eighteen syllables in a second, which is the top of the range the library measures before the ear stops counting them. The trill is not a modulation inside one syllable -- only ten of the library's 4287 syllables have one of those -- it is syllables arriving too fast to separate, with Legato high enough that they run together.
features = trill, fast, virtuoso, solo

# Syllable
pitch = 5200
sweep = 0.35
contour = 0.25
turns = 0.25
length = 40
skew = 0.37
jitter = 0.12
pulse_rate = 30
pulse_depth = 0.4

# Timbre
species = Warbler
voice = 0.3
breath = 0.1
tract = 4.9
beak = 0.5
formant = 0.55
rasp = 0
radiate = 0.35

# Phrase
syllables = 18
syllable_rate = 18
rate_drift = 0.2
legato = 0.85
motif = 0
variation = 0.2
phrase_gap = 0.31
repeats = 1

# Flock
shot_level = 0
flock_level = -60
flock_rate = 273
birds = 5
pitch_spread = 0.8
voice_spread = 0.3
answer = 0.35
restless = 0.4
max_voices = 24

# Drum
drum_level = -60
drum_rate = 6
strikes = 10
strike_rate = 15
drum_accel = 0.23
knock = 1000
ring = 13

# Place
distance = 0.15
distance_spread = 0.4
air = 0.5
width = 0.6
space_amount = 0.3
space_size = 0.55
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2
decay = 400
sustain = 1
release = 600
vel_to_level = 0.6
vel_to_pitch = 0.2

# Output
gain = 1
seed = 0

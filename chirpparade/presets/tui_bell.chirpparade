# ChirpParade preset
format = 1
name = Tui Bell
author = ChirpParade
description = What the tract does on its own. A short trachea and a wide beak put the resonance high and broad, and Formant well up makes it most of what is heard -- the source is the same valve as everything else. In the library's harmonic syllables the loudest harmonic is not the first in 80 % of cases, and this is that effect used deliberately.
features = exotic, bell, tract, strange

# Syllable
pitch = 2400
sweep = 100
contour = 0.4
detail = 1
length = 120
skew = 0.5
jitter = 0.12
pulse_rate = 13.2
pulse_depth = 0

# Timbre
species = Warbler
voice = 0.4
breath = 0.05
tract = 3.2
beak = 0.8
formant = 0.85
rasp = 0.2
radiate = 0.35

# Phrase
syllables = 4
syllable_rate = 5
rate_drift = 0
legato = 0.5
motif = 5
variation = 0.45
phrase_gap = 0.31
repeats = 1

# Flock
shot_level = 0
flock_level = -18
flock_rate = 273
birds = 2
pitch_spread = 0.8
voice_spread = 0.3
answer = 0.35
restless = 0.4
max_voices = 24

# Drum
drum_level = -60
drum_rate = 6
strikes = 10
strike_rate = 15
drum_accel = 0.23
knock = 1000
ring = 13

# Place
distance = 0.2
distance_spread = 0.4
air = 0.5
width = 0.6
space_amount = 0.4
space_size = 0.6
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2
decay = 400
sustain = 1
release = 600
vel_to_level = 0.6
vel_to_pitch = 0.2

# Output
gain = -1.8
seed = 0

# ChirpParade preset
format = 1
name = Robin Whistle
author = ChirpParade
description = The purest voice in the library. The three robin recordings measure one harmonic, a spectral flatness of -34 dB -- the cleanest of any group -- and a 4.7 kHz fundamental, so Breath is almost shut and the drive is low enough that the labia barely leave a sinusoid. Four notes with a slight fall between them.
features = whistle, pure, high, solo
# fit harmonics=1 rough=-34

# Syllable
pitch = 2560
sweep = 0.22
contour = 0.25
turns = 0.25
length = 130
skew = 0.37
jitter = 0.12
pulse_rate = 13.2
pulse_depth = 0.2

# Timbre

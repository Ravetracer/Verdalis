voice = 0.2
breath = 0.05
tract = 4.9
beak = 0.5
formant = 0.55
rasp = 0
radiate = 0.35

# Phrase
syllables = 4
syllable_rate = 5
rate_drift = 0
legato = 0.4
motif = -2
variation = 0.3
phrase_gap = 0.31
repeats = 1

# Flock

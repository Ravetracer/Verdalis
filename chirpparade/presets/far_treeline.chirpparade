# ChirpParade preset
format = 1
name = Far Treeline
author = ChirpParade
description = Birds a field away. Distance takes the level down by its inverse and the top off by air absorption, and the highpass and the output filter finish what the air started. Detail is pulled back a little: fine contour motion is the first thing distance takes, so smoothing it is what makes far birds sound far rather than quiet.

# Syllable
pitch = 2600
sweep = 100
contour = 0.5
detail = 0.7
length = 96
skew = 0.5
jitter = 0.12
pulse_rate = 13.2
pulse_depth = 0

# Timbre
species = Sparrow
voice = 0.3
breath = 0.05
tract = 4.9
beak = 0.5
formant = 0.55
rasp = 0
radiate = 0.35
partials = 0.6

# Phrase
syllables = 3
syllable_rate = 7.5
rate_drift = 0
legato = 0.7
motif = 0
variation = 0.35
phrase_gap = 0.31
repeats = 1

# Flock
shot_level = -60
flock_level = -2
flock_rate = 420
birds = 10
pitch_spread = 1.6
voice_spread = 0.3
answer = 0.35
restless = 0.5
max_voices = 40

# Drum
drum_level = -60
drum_rate = 6
strikes = 10
strike_rate = 15
drum_accel = 0.23
knock = 1000
ring = 13

# Place
distance = 0.85
distance_spread = 0.5
air = 0.35
width = 0.7
space_amount = 0.5
space_size = 0.8
space_damping = 0.7

# Filter
filter_type = Lowpass
highpass = 250
filter_cutoff = 6000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2
decay = 400
sustain = 1
release = 600
vel_to_level = 0.6
vel_to_pitch = 0.2

# Output
gain = 12
seed = 0

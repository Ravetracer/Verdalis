# ChirpParade preset
format = 1
name = Goose Flight
author = ChirpParade
description = Geese going over. Only one goose recording survived the contour gate, so this species has a single archetype and Contour does nothing on it -- the variety has to come from Sweep, Skew and the flock instead. Spread over six birds at different distances, which is most of what makes a skein sound like a skein.

# Syllable
pitch = 2560
sweep = 120
contour = 0.5
detail = 1
length = 96
skew = 0.62
jitter = 0.12
pulse_rate = 13.2
pulse_depth = 0

# Timbre
species = Goose
voice = 0.3
breath = 0.05
tract = 4.9
beak = 0.5
formant = 0.55
rasp = 0.15
radiate = 0.35
partials = 0.6

# Phrase
syllables = 4
syllable_rate = 2.8
rate_drift = 0
legato = 0.2
motif = 0
variation = 0.35
phrase_gap = 0.31
repeats = 1

# Flock
shot_level = -6
flock_level = -8
flock_rate = 200
birds = 6
pitch_spread = 0.5
voice_spread = 0.3
answer = 0.5
restless = 0.4
max_voices = 24

# Drum
drum_level = -60
drum_rate = 6
strikes = 10
strike_rate = 15
drum_accel = 0.23
knock = 1000
ring = 13

# Place
distance = 0.5
distance_spread = 0.65
air = 0.5
width = 0.75
space_amount = 0.2
space_size = 0.55
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2
decay = 400
sustain = 1
release = 600
vel_to_level = 0.6
vel_to_pitch = 0.2

# Output
gain = 7.9
seed = 0

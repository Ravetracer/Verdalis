# ChirpParade preset
format = 1
name = Single Chirp
author = ChirpParade
description = One syllable, one bird, no flock: the plugin reduced to what a note does. The contour is one measured sparrow chirp and nothing is smoothing it, so this is the preset to sweep Contour on and hear what the archetypes actually are. Dry on purpose -- the room is the next thing to add, not part of the syllable.
features = one shot, dry, close, placed
# fit pitch=3172 length=60 harmonics=1 rough=-29

# Syllable
pitch = 2600
sweep = 100
contour = 0.5
detail = 1
length = 96
skew = 0.5
jitter = 0.08
pulse_rate = 13.2
pulse_depth = 0

# Timbre
species = Sparrow
voice = 0.3
breath = 0.05
tract = 4.9
beak = 0.5
formant = 0.55
rasp = 0
radiate = 0.35

# Phrase
syllables = 1
syllable_rate = 7.5
rate_drift = 0
legato = 0.7
motif = 0
variation = 0.15
phrase_gap = 0.31
repeats = 1

# Flock
shot_level = 0
flock_level = -60
flock_rate = 273
birds = 1
pitch_spread = 0
voice_spread = 0.3
answer = 0.35
restless = 0.4
max_voices = 24

# Drum
drum_level = -60
drum_rate = 6
strikes = 10
strike_rate = 15
drum_accel = 0.23
knock = 1000
ring = 13

# Place
distance = 0.05
distance_spread = 0
air = 0.5
width = 0.6
space_amount = 0
space_size = 0.55
space_damping = 0.6

# Filter
filter_type = Lowpass
highpass = 20
filter_cutoff = 20000
filter_reso = 0.1
filter_keytrack = 0

# Envelope
attack = 2
decay = 400
sustain = 1
release = 600
vel_to_level = 0.6
vel_to_pitch = 0.2

# Output
gain = -4.9
seed = 0

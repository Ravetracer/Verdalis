voice = 0.3
breath = 0.05
tract = 4.9
beak = 0.5
formant = 0.55
rasp = 0
radiate = 0.35

# Phrase
syllables = 6
syllable_rate = 16
rate_drift = 0
legato = 0.75
motif = 0
variation = 0.3
phrase_gap = 0.31
repeats = 1

# Flock
shot_level = -3
flock_level = -6
flock_rate = 640
birds = 7
pitch_spread = 0.8
voice_spread = 0.3
answer = 0.6
restless = 0.6
max_voices = 40

# Drum
drum_level = -60
drum_rate = 6
strikes = 10

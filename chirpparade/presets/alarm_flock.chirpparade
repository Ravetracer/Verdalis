# ChirpParade preset
format = 1
name = Alarm Flock
author = ChirpParade
description = Short, high and fast, which is what an alarm call is for: hard to locate and impossible to ignore. 45 ms syllables at sixteen a second, seven birds, and Restless well up so the density lurches rather than holding steady.
features = alarm, nervous, fast, bright

# Syllable
pitch = 3400
sweep = 130
contour = 0.2
detail = 1
length = 45
skew = 0.5
jitter = 0.2
pulse_rate = 13.2
pulse_depth = 0

# Timbre
